{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["color", "stroke", "radius", "spacing", "typography"],
  "properties": {
    "color": { "type": "object", "additionalProperties": { "type": "string" } },
    "stroke": { "type": "object", "additionalProperties": { "type": "number" } },
    "radius": { "type": "object", "additionalProperties": { "type": "number" } },
    "spacing": { "type": "object", "additionalProperties": { "type": "number" } },
    "typography": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
  }
}
